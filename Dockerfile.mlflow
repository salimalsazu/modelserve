FROM python:3.10-slim

WORKDIR /app

# Install MLflow and Kaggle for training
RUN pip install --no-cache-dir \
    mlflow>=2.14.0 \
    kaggle>=1.5.0 \
    psycopg2-binary \
    gunicorn \
    boto3

# Expose MLflow port
EXPOSE 5000

# Run MLflow server with host 0.0.0.0 and disable security
ENV MLFLOW_TRACKING_INSECURE_USE_HTTP=true

CMD ["mlflow", "server", "--host", "0.0.0.0", "--port", "5000", "--backend-store-uri", "sqlite:///mlflow.db", "--serve-artifacts"]